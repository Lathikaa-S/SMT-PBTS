{
  "name": "tscircuit",
  "version": "1.0.0",
  "description": "Tscircuit engineering recreation of the SMT-PBTS v4.0 Bluetooth speaker PCB",
  "main": "index.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build",
    "snapshot": "tsci snapshot index.circuit.tsx",
    "snapshot:update": "tsci snapshot index.circuit.tsx --update --force-update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "tscircuit": "^0.0.2646",
    "typescript": "^5.0.0"
  }
}
